// Cloudflare Worker config: serve the repo as static files; only /pbp and /live.html run worker/index.js.
{
  "name": "cavsdatabase",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/pbp", "/nba", "/live.html", "/live", "/coffee", "/newsletter", "/stats", "/stats/"]
  }
}
